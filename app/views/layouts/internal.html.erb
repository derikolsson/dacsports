<!DOCTYPE html>
<html>
  <head>
    <title>INTERNAL | DAC Sports Network</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "internal", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script type="module">
      import { initializeCopyButtons } from 'copy_button';
      import { initializePasskeys } from 'passkeys';
      initializeCopyButtons();
      initializePasskeys();
    </script>
  </head>

  <body>
    <div class="container">
      <div class="d-flex justify-content-end align-items-center gap-3 pt-2 small text-body-secondary d-print-none">
        <span>Signed in as <%= current_user.display_name %></span>
        <%= link_to "Account", edit_internal_account_path, class: "link-secondary" %>
        <%= button_to "Sign out", internal_logout_path, method: :delete, class: "btn btn-link btn-sm p-0 text-body-secondary" %>
      </div>
      <header class="d-flex flex-wrap justify-content-center align-items-center py-3 mb-4 border-bottom d-print-none">
        <%= link_to internal_root_path, class: 'd-flex align-items-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none title-link' do %>
          <%= image_tag 'logo.png', alt: 'Dallas Athletic Conference Logo', class: 'logo' %>
          <span class="fs-1 ms-2">DAC Sports Network</span>
        <% end %>

        <ul class="nav nav-pills">
          <li class="nav-item"><%= link_to "Dashboard", internal_root_path, class: "nav-link #{'active' if controller_name == 'home'}" %></li>
          <li class="nav-item"><%= link_to "Reports", internal_reports_path, class: "nav-link #{'active' if controller_name == 'reports'}" %></li>
          <li class="nav-item"><%= link_to "Events", internal_events_path, class: "nav-link #{'active' if controller_name == 'events'}" %></li>
          <li class="nav-item">
            <%= link_to internal_uploads_path, class: "nav-link #{'active' if controller_name == 'uploads'}" do %>
              Upload <i class="bi bi-cloud-arrow-up ms-1"></i>
            <% end %>
          </li>
          <li class="nav-item dropdown">
            <% manage_controllers = %w[teams channels vocabularies embed_settings embed_previews users] %>
            <a class="nav-link dropdown-toggle <%= 'active' if controller_name.in?(manage_controllers) %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Manage</a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><%= link_to "Teams", internal_teams_path, class: "dropdown-item #{'active' if controller_name == 'teams'}" %></li>
              <li><%= link_to "Captions", internal_vocabulary_path, class: "dropdown-item #{'active' if controller_name == 'vocabularies'}" %></li>
              <li><%= link_to "Embeds", internal_embed_settings_path, class: "dropdown-item #{'active' if controller_name.in?(%w[embed_settings embed_previews])}" %></li>
              <% if current_user.admin? %>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Admin</h6></li>
                <li><%= link_to "Channels", internal_channels_path, class: "dropdown-item #{'active' if controller_name == 'channels'}" %></li>
                <li><%= link_to "Users", internal_users_path, class: "dropdown-item #{'active' if controller_name == 'users'}" %></li>
                <li><%= link_to "Sidekiq", '/internal/sidekiq', class: "dropdown-item", target: "_blank", rel: "noopener noreferrer" %></li>
              <% end %>
            </ul>
          </li>
          <li class="nav-item">
            <%= link_to root_path, class: "nav-link" do %>
              Back to Site <i class="bi bi-house-door ms-1"></i>
            <% end %>
          </li>
        </ul>
      </header>

      <% if flash[:notice] %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="alert alert-danger"><%= flash[:alert] %></div>
      <% end %>

      <div id="main" class="pb-5">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
