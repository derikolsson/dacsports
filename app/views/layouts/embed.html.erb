<!DOCTYPE html>
<html>
  <head>
    <title>DAC Sports Network</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%# Deliberately minimal: no navbar, no Fathom, no Bootstrap. This page is framed on
        someone else's site and should ship as little as possible. %>
    <style>
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; background: #000; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
      .embed-stage { position: relative; width: 100%; height: 100%; overflow: hidden; }
      mux-player {
        width: 100%; height: 100%; display: block;
        /* Restriction A has no casting domains, so casting would silently fail here. */
        --cast-button: none;
        --airplay-button: none;
      }
      .embed-slate {
        position: absolute; inset: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: .5rem; padding: 1.5rem; text-align: center;
        background: #0b0b0c; color: #f5f5f5;
      }
      .embed-slate__brand {
        font-size: 1.05rem; letter-spacing: .1em; text-transform: uppercase;
        color: #f5f5f5; font-weight: 700;
      }
      .embed-slate__title { font-size: .9rem; font-weight: 600; color: #d4d4d8; margin: 0; }
      .embed-slate__message { font-size: .85rem; color: #a1a1aa; margin: 0; max-width: 34rem; line-height: 1.45; }
      @media (max-width: 480px) {
        .embed-slate__title { font-size: .95rem; }
        .embed-slate__message { font-size: .8rem; }
      }
    </style>
  </head>
  <body>
    <div class="embed-stage"><%= yield %></div>
    <script>
      // Tell the wrapper we rendered. Sent from the layout so every response reports in,
      // including the holding slates — otherwise the wrapper's cover would sit on top of
      // a page that is perfectly fine and hide what it says.
      try {
        if (window.parent !== window) {
          window.parent.postMessage({ source: "dac-sports-network", type: "ready" }, "*");
        }
      } catch (e) {}
    </script>
  </body>
</html>
