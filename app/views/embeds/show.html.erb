<% if @tokens.present? %>
  <%= signed_mux_player(
        playback_id: @playback_id,
        tokens: @tokens,
        title: @event.title,
        video_id: @event.slug,
        stream_type: @stream_type,
        start_time: (@event.replay_start_time unless @live),
        end_time: (@event.replay_end_time unless @live)
      ) %>
<% else %>
  <%# No token is signed in these states. A reload that re-signed would just hand a
      fresh token to someone being cut off, so the denial state has to be real. %>
  <%= render "slate", title: @event.title, message: embed_slate_message(@event) %>
<% end %>

<%# A preview is a one-off look by an operator, so it does not poll: the poller reloads
    on any status change, which is exactly what a preview is waiting on. %>
<% unless @preview %>
<script type="module">
  import { initializeEmbedPolling } from '<%= asset_path("embed_polling.js") %>';

  initializeEmbedPolling({
    eventSlug: <%= @event.slug.to_json.html_safe %>,
    eventStatus: <%= (@event.replay_available? ? "vod" : @event.status).to_json.html_safe %>,
    forceReloadVersion: <%= @event.force_reload_count.to_i %>,
    sessionId: <%= @session_id.to_json.html_safe %>,
    sourceToken: <%= @source_token.to_json.html_safe %>,
    enabled: <%= @tokens.present? %>,
    initialTtl: <%= @poll_ttl %>
  });
</script>
<% end %>
