<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <h1 class="mb-0">Analytics Dashboard</h1>
  <div class="btn-group" role="group" aria-label="Audience">
    <%= link_to "dacsports.net", internal_root_path, class: "btn btn-sm btn-outline-primary #{"active" if @source == ReportsQuery::ON_SITE}" %>
    <%= link_to "Partner sites", internal_root_path(source: ReportsQuery::ALL_PARTNERS), class: "btn btn-sm btn-outline-primary #{"active" if @source == ReportsQuery::ALL_PARTNERS}" %>
  </div>
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
  <div class="col">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title mb-0">Watching Now</h5>
        <small class="text-muted d-block mb-2">All audiences, last 3 minutes</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@active_viewers[:total]) %></p>
        <small class="text-muted"><%= number_with_delimiter(@active_viewers[:on_site]) %> on dacsports.net · <%= number_with_delimiter(@active_viewers[:partners]) %> on partner sites</small>
      </div>
    </div>
  </div>
  <% [
       [ "Viewers", "Unique browsers, last 7 days", :total, :users ],
       [ "Views", "Viewing sessions, last 7 days", :total, :views ],
       [ "Live Views", "Sessions watching live, last 7 days", :live, :views ]
     ].each do |title, help, status, metric| %>
    <div class="col">
      <%= link_to @week_link, class: "card h-100 text-reset text-decoration-none" do %>
        <div class="card-body">
          <h5 class="card-title mb-0"><%= title %></h5>
          <small class="text-muted d-block mb-2"><%= help %></small>
          <p class="display-6 mb-1"><%= number_with_delimiter(@week[:current][status][metric]) %></p>
          <%= period_change(@week[:current][status][metric], @week[:previous][status][metric]) %>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="col">
    <%= link_to internal_reports_path(start_date: 6.days.ago.to_date, end_date: Date.current, source: ReportsQuery::ALL_PARTNERS), class: "card h-100 text-reset text-decoration-none" do %>
      <div class="card-body">
        <h5 class="card-title mb-0">Partner Share</h5>
        <small class="text-muted d-block mb-2">Of all views, last 7 days</small>
        <p class="display-6 mb-1"><%= @partner_share[:current] %>%</p>
        <small class="text-muted d-block"><%= @partner_share[:previous] %>% the week before</small>
      </div>
    <% end %>
  </div>
</div>

<%= render "internal/shared/viewers_trend", series: @trend,
           title: "Last 30 Days on #{@source == ReportsQuery::ON_SITE ? "dacsports.net" : "Partner Sites"}" %>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Currently Watching</h5>
  </div>
  <div class="card-body">
    <% if @active_viewers_by_event.empty? %>
      <p class="text-muted">No active viewers</p>
    <% else %>
      <table class="table">
        <thead>
          <tr>
            <th>Event</th>
            <th>Type</th>
            <th>Where</th>
            <th>Viewers</th>
          </tr>
        </thead>
        <tbody>
          <% @active_viewers_by_event.each do |row| %>
            <tr>
              <td><%= row[:event].title %> (<code><%= row[:event].slug %></code>)</td>
              <td>
                <span class="badge bg-<%= row[:status] == 'live' ? 'success' : 'primary' %>">
                  <%= row[:status].titleize %>
                </span>
              </td>
              <td><%= row[:partner] ? "Partner sites" : "dacsports.net" %></td>
              <td><%= row[:viewers] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Top Browsers</h5>
      </div>
      <div class="card-body">
        <table class="table table-sm">
          <tbody>
            <% @browser_breakdown.each do |browser, count| %>
              <tr>
                <td><%= browser || 'Unknown' %></td>
                <td class="text-end"><%= count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Top Operating Systems</h5>
      </div>
      <div class="card-body">
        <table class="table table-sm">
          <tbody>
            <% @os_breakdown.each do |os, count| %>
              <tr>
                <td><%= os || 'Unknown' %></td>
                <td class="text-end"><%= count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Device Types</h5>
  </div>
  <div class="card-body">
    <table class="table table-sm">
      <tbody>
        <% @device_breakdown.each do |device, count| %>
          <tr>
            <td><%= device || 'Unknown' %></td>
            <td class="text-end"><%= count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
