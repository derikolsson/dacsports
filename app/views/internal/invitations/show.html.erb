<% content_for :title, "Accept invitation" %>

<h1 class="h4 mb-2">Welcome to DAC Sports Network</h1>
<p class="text-body-secondary small">Set up your account for <strong><%= @user.email_address %></strong>.</p>

<%= render "internal/shared/errors", record: @user %>

<%= form_with model: @user, url: internal_invitation_path(params[:token]), method: :patch do |f| %>
  <%= hidden_field_tag :email_address, @user.email_address, autocomplete: "username" %>
  <div class="mb-3">
    <%= f.label :name, "Your name", class: "form-label" %>
    <%= f.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :password, class: "form-label" %>
    <%= f.password_field :password, required: true, autocomplete: "new-password",
          minlength: User::MINIMUM_PASSWORD_LENGTH, class: "form-control" %>
    <small class="form-text text-muted">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</small>
  </div>
  <div class="mb-3">
    <%= f.label :password_confirmation, "Confirm password", class: "form-label" %>
    <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-control" %>
  </div>
  <%= f.submit "Create account", class: "btn btn-primary w-100" %>
<% end %>
