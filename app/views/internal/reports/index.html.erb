<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
  <h1 class="mb-0">Reports</h1>
  <div>
    <%= link_to "Export CSV", internal_reports_path(format: :csv, start_date: @start_date.to_date, end_date: @end_date.to_date, **@filters), class: "btn btn-outline-primary me-2" %>
    <%= link_to "https://app.usefathom.com/share/bpvxynyg/dac+sports+network", class: "btn btn-outline-secondary", target: "_blank", rel: "noopener noreferrer" do %>
      Web Analytics <i class="bi bi-box-arrow-up-right ms-1"></i>
    <% end %>
  </div>
</div>
<% range_label = "#{@start_date.strftime("%b %-d, %Y")} – #{@end_date.strftime("%b %-d, %Y")}" %>
<h1 class="mb-4 d-none d-print-block">
  DAC Sports Network – Viewership: <%= range_label %><%= " · #{[ @sport, @team&.name ].compact.join(" · ")}" if @sport || @team %>
  <small class="d-block fs-6 text-muted">Viewing that happened in this period, for events of any date</small>
</h1>

<div class="card mb-4 d-print-none">
  <div class="card-body">
    <%= form_with url: internal_reports_path, method: :get, local: true do %>
      <%# When: the period, with shortcuts that keep every other filter. %>
      <div class="row g-3 align-items-end mb-3">
        <div class="col-auto">
          <%= label_tag :start_date, "Start Date", class: "form-label" %>
          <%= date_field_tag :start_date, @start_date, class: "form-control" %>
        </div>
        <div class="col-auto">
          <%= label_tag :end_date, "End Date", class: "form-label" %>
          <%= date_field_tag :end_date, @end_date, class: "form-control" %>
        </div>
        <div class="col-auto">
          <div class="btn-group" role="group" aria-label="Date shortcuts">
            <%= link_to "Last 7 Days", internal_reports_path(start_date: 7.days.ago.to_date, end_date: Date.current, **@filters), class: "btn btn-outline-secondary" %>
            <%= link_to "Last 30 Days", internal_reports_path(start_date: 30.days.ago.to_date, end_date: Date.current, **@filters), class: "btn btn-outline-secondary" %>
            <%= link_to "Last 90 Days", internal_reports_path(start_date: 90.days.ago.to_date, end_date: Date.current, **@filters), class: "btn btn-outline-secondary" %>
            <%= link_to "All Time", internal_reports_path(start_date: ReportsQuery::ALL_TIME_START, end_date: Date.current, **@filters), class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>

      <%# What: whose viewing, of which events. %>
      <div class="row g-3 align-items-end">
        <div class="col-auto">
          <%= label_tag :source, "Audience", class: "form-label" %>
          <%= select_tag :source,
                grouped_options_for_select(
                  [
                    [ "DAC Sports Network", [ [ "DAC Sports Network site", ReportsQuery::ON_SITE ] ] ],
                    [ "Partners", [ [ "All partner sites", ReportsQuery::ALL_PARTNERS ] ] + @partner_options ]
                  ],
                  @source
                ),
                class: "form-select" %>
        </div>
        <div class="col-auto">
          <%= label_tag :sport, "Sport", class: "form-label" %>
          <%= select_tag :sport, options_for_select(Event::SPORTS, @sport), include_blank: "All sports", class: "form-select" %>
        </div>
        <div class="col-auto">
          <%= label_tag :team_id, "Team", class: "form-label" %>
          <%= select_tag :team_id, options_from_collection_for_select(@teams, :id, :name, @team&.id), include_blank: "All teams", class: "form-select" %>
        </div>
        <div class="col-auto">
          <%= submit_tag "Apply", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
    <p class="form-text mb-0 mt-3">
      Counting viewing that happened <%= range_label %>, including replays of events that aired earlier.
      <% if @sport || @team %>
        Only <%= [ @sport, @team&.name ].compact.join(" · ") %> events.
      <% end %>
    </p>
  </div>
</div>

<%= render "audience_banner" %>

<%= render "internal/shared/viewers_trend", series: @trend, title: "Viewers over Time" %>

<h4 class="mb-1">Summary</h4>
<p class="text-muted small mb-3">
  Users are unique browsers on each site, so one person on a phone and a laptop counts twice, and partner sites can't be matched with each other.
  A view is one viewing session; a session ends after 10 minutes away.
</p>
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">Live Users</h5>
        <small class="text-muted d-block mb-2">Unique browsers that watched live.</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@summary[:live][:users]) %></p>
        <%= period_change(@summary[:live][:users], @previous_summary&.dig(:live, :users)) %>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">Live Views</h5>
        <small class="text-muted d-block mb-2">Viewing sessions of live events.</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@summary[:live][:views]) %></p>
        <%= period_change(@summary[:live][:views], @previous_summary&.dig(:live, :views)) %>
        <% peak = @event_stats.max_by { |e| e["live_peak"] } %>
        <% if peak && peak["live_peak"].positive? %>
          <small class="text-muted d-block">Peak <%= number_with_delimiter(peak["live_peak"]) %> watching at once, <%= peak["title"] %></small>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">VOD Users</h5>
        <small class="text-muted d-block mb-2">Unique browsers that watched a replay.</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@summary[:vod][:users]) %></p>
        <%= period_change(@summary[:vod][:users], @previous_summary&.dig(:vod, :users)) %>
        <small class="text-muted"><%= number_with_delimiter(@summary[:vod_30d][:users]) %> within 30 days of the event</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">VOD Views</h5>
        <small class="text-muted d-block mb-2">Viewing sessions of replays.</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@summary[:vod][:views]) %></p>
        <%= period_change(@summary[:vod][:views], @previous_summary&.dig(:vod, :views)) %>
        <small class="text-muted"><%= number_with_delimiter(@summary[:vod_30d][:views]) %> within 30 days of the event</small>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">Time with the Player Open <span class="badge text-bg-light fw-normal">Estimate</span></h5>
        <small class="text-muted d-block mb-2">How long pages with the player stayed open. It can't tell playing from paused.</small>
        <% hours = ->(summary) { (summary[:player][:minutes] / 60.0).round if summary } %>
        <p class="display-6 mb-1"><%= number_with_delimiter(hours.(@summary)) %> hours</p>
        <%= period_change(hours.(@summary), hours.(@previous_summary)) %>
        <small class="text-muted d-block"><%= @summary[:player][:per_visit] %> minutes per view on average</small>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">Play Rate</h5>
        <small class="text-muted d-block mb-2">Views where the video actually played, rather than the page just being open.</small>
        <% plays = @summary[:plays] %>
        <% if plays[:pct] %>
          <p class="display-6 mb-1"><%= plays[:pct] %>%</p>
          <small class="text-muted d-block"><%= number_with_delimiter(plays[:plays]) %> of <%= number_with_delimiter(plays[:views]) %> views since play tracking began <%= plays[:since].strftime("%b %-d, %Y") %></small>
        <% else %>
          <p class="display-6 mb-1 text-muted">—</p>
          <small class="text-muted d-block"><%= plays[:since] ? "No views in this period since play tracking began." : "Play tracking hasn't recorded a play yet." %></small>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">By Device Type</h5>
      </div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <thead>
            <tr>
              <th></th>
              <th class="text-end">Live</th>
              <th class="text-end">VOD</th>
            </tr>
          </thead>
          <tbody>
            <% @device_breakdown.each do |device, stats| %>
              <tr>
                <td><%= device %></td>
                <td class="text-end"><%= number_to_percentage(stats[:live], precision: 1) %> <small class="text-muted">(<%= number_with_delimiter(stats[:live_count]) %>)</small></td>
                <td class="text-end"><%= number_to_percentage(stats[:vod], precision: 1) %> <small class="text-muted">(<%= number_with_delimiter(stats[:vod_count]) %>)</small></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">By Operating System</h5>
      </div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <thead>
            <tr>
              <th></th>
              <th class="text-end">Live</th>
              <th class="text-end">VOD</th>
            </tr>
          </thead>
          <tbody>
            <% @os_breakdown.each do |os, stats| %>
              <tr>
                <td><%= os %></td>
                <td class="text-end"><%= number_to_percentage(stats[:live], precision: 1) %> <small class="text-muted">(<%= number_with_delimiter(stats[:live_count]) %>)</small></td>
                <td class="text-end"><%= number_to_percentage(stats[:vod], precision: 1) %> <small class="text-muted">(<%= number_with_delimiter(stats[:vod_count]) %>)</small></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% if @partner_stats %>
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">By Partner Site</h5>
    </div>
    <div class="card-body">
      <% if @partner_stats.empty? %>
        <p class="text-muted mb-0">No partner viewing in the selected period.</p>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead>
              <tr>
                <th>Partner site</th>
                <th class="text-end">Live users</th>
                <th class="text-end">Live views</th>
                <th class="text-end">VOD users</th>
                <th class="text-end">VOD views</th>
                <th class="text-end">Share of views</th>
              </tr>
            </thead>
            <tbody>
              <% @partner_stats.each do |partner| %>
                <tr>
                  <td><%= link_to partner[:label], internal_reports_path(start_date: @start_date.to_date, end_date: @end_date.to_date, **@filters, source: partner[:source]) %></td>
                  <td class="text-end"><%= number_with_delimiter(partner[:live_users]) %></td>
                  <td class="text-end"><%= number_with_delimiter(partner[:live_views]) %></td>
                  <td class="text-end"><%= number_with_delimiter(partner[:vod_users]) %></td>
                  <td class="text-end"><%= number_with_delimiter(partner[:vod_views]) %></td>
                  <td class="text-end"><%= number_to_percentage(partner[:share], precision: 1) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Traffic Sources</h5>
  </div>
  <div class="card-body">
    <p class="text-muted small">
      <%= @source == ReportsQuery::ON_SITE ? "Where viewers came from when they arrived on dacsports.net." : "Where viewers came from when they arrived on the partner page." %>
      A UTM source is shown when the link had one; otherwise the referring site.
    </p>
    <% if @traffic_sources.empty? %>
      <p class="text-muted mb-0">No traffic sources recorded in the selected period.</p>
    <% else %>
      <table class="table table-sm table-hover mb-0">
        <thead><tr><th>Source</th><th>Campaign</th><th class="text-end">Views</th></tr></thead>
        <tbody>
          <% @traffic_sources.each do |row| %>
            <tr>
              <td class="text-break"><%= row[:source] %></td>
              <td class="text-break"><%= row[:campaign] || content_tag(:span, "—", class: "text-muted") %></td>
              <td class="text-end"><%= number_with_delimiter(row[:views]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<% if @top_pages %>
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">Top Partner Pages</h5>
    </div>
    <div class="card-body">
      <% if @top_pages.empty? %>
        <p class="text-muted mb-0">No partner pages recorded in the selected period.</p>
      <% else %>
        <table class="table table-sm table-hover mb-0">
          <thead><tr><th>Page</th><th class="text-end">Views</th></tr></thead>
          <tbody>
            <% @top_pages.each do |page| %>
              <tr>
                <td class="text-break">
                  <%= page[:title].presence || page[:url] %><br>
                  <small><%= link_to page[:url], page[:url], target: "_blank", rel: "noopener noreferrer nofollow", class: "text-muted" %></small>
                </td>
                <td class="text-end"><%= number_with_delimiter(page[:views]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>

<% columns = ReportsQuery::EVENT_COLUMNS.map { |key, label| [ label, key == "live" ? "table-danger" : key, "#{key}_viewers", "#{key}_views" ] } %>
<div class="card mb-5">
  <div class="card-header">
    <h5 class="mb-0">Breakdown per Event</h5>
  </div>
  <div class="card-body">
    <% if @event_stats.empty? %>
      <p class="text-muted mb-0">No viewing in the selected period.</p>
    <% else %>
      <div class="table-responsive">
        <table class="table table-bordered table-hover mb-0 event-breakdown-table" style="--bs-border-color: #adb5bd;">
          <colgroup>
            <col class="event-col">
            <col class="data-col"><col class="data-col"><col class="data-col">
            <% columns.each do %><col class="data-col"><col class="data-col"><% end %>
          </colgroup>
          <thead>
            <tr>
              <th rowspan="2" class="align-bottom"><%= event_sort_link "Event", "title" %> <small class="fw-normal">· <%= event_sort_link "Aired", "start_at" %></small></th>
              <th rowspan="2" class="align-bottom text-end" title="Most people watching live at the same moment"><%= event_sort_link "Peak live", "live_peak" %></th>
              <th rowspan="2" class="align-bottom text-end" title="Estimated from how long pages with the player stayed open"><%= event_sort_link "Est. hours", "player_minutes" %></th>
              <th rowspan="2" class="align-bottom text-end" title="Views where the video actually played, since play tracking began"><%= event_sort_link "Play rate", "plays" %></th>
              <% columns.each do |label, css, _, _| %>
                <th colspan="2" class="text-center <%= css %> group-start"><%= label %></th>
              <% end %>
            </tr>
            <tr>
              <% columns.each do |_, css, viewers, views| %>
                <th class="text-end <%= css %> group-start"><%= event_sort_link "Viewers", viewers %></th>
                <th class="text-end <%= css %>"><%= event_sort_link "Views", views %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @event_stats.each do |event| %>
              <tr>
                <td>
                  <%= event["title"] %>
                  <br>
                  <small class="text-muted"><%= event["start_at"]&.in_time_zone("America/Chicago")&.strftime("%b %d %l:%M%P") %><%= " · #{event["sport"]}" if event["sport"].present? %></small>
                </td>
                <td class="text-end"><%= number_with_delimiter(event["live_peak"]) %></td>
                <td class="text-end"><%= number_with_delimiter((event["player_minutes"].to_f / 60).round(1)) %></td>
                <td class="text-end"><%= event["play_tracked_views"].positive? ? number_to_percentage(event["plays"] * 100.0 / event["play_tracked_views"], precision: 0) : "—" %></td>
                <% columns.each do |_, css, viewers, views| %>
                  <td class="text-end <%= css %> group-start"><%= event[viewers] || 0 %></td>
                  <td class="text-end <%= css %>"><%= event[views] || 0 %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="fw-semibold">
              <td>Total of <%= pluralize(@event_stats.size, "event") %></td>
              <td></td>
              <td class="text-end"><%= number_with_delimiter((@event_stats.sum { |e| e["player_minutes"].to_f } / 60).round(1)) %></td>
              <td></td>
              <% columns.each do |_, css, viewers, views| %>
                <td class="text-end <%= css %> group-start"><%= number_with_delimiter(@event_stats.sum { |e| e[viewers].to_i }) %></td>
                <td class="text-end <%= css %>"><%= number_with_delimiter(@event_stats.sum { |e| e[views].to_i }) %></td>
              <% end %>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="text-muted small mt-2 mb-0">
        Totals add each event's figures together. Someone who watched two events counts in both rows, so the viewer totals here run higher than the Summary.
      </p>
    <% end %>
  </div>
</div>
