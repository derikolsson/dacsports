<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
  <h1 class="mb-0">Reports</h1>
  <%= link_to "https://app.usefathom.com/share/bpvxynyg/dac+sports+network", class: "btn btn-outline-secondary", target: "_blank", rel: "noopener noreferrer" do %>
    Web Analytics <i class="bi bi-box-arrow-up-right ms-1"></i>
  <% end %>
</div>
<% activity = @basis == ReportsQuery::ACTIVITY %>
<% range_label = "#{@start_date.strftime("%b %-d, %Y")} – #{@end_date.strftime("%b %-d, %Y")}" %>
<h1 class="mb-4 d-none d-print-block">
  DAC Sports Network – Viewership: <%= range_label %>
  <small class="d-block fs-6 text-muted"><%= activity ? "Viewing that happened in this period" : "All viewing of events that aired in this period" %></small>
</h1>

<div class="card mb-4 d-print-none">
  <div class="card-body">
    <%= form_with url: internal_reports_path, method: :get, local: true, class: "row g-3 align-items-end" do %>
      <div class="col-auto">
        <%= label_tag :start_date, "Start Date", class: "form-label" %>
        <%= date_field_tag :start_date, @start_date, class: "form-control" %>
      </div>
      <div class="col-auto">
        <%= label_tag :end_date, "End Date", class: "form-label" %>
        <%= date_field_tag :end_date, @end_date, class: "form-control" %>
      </div>
      <div class="col-auto">
        <%= label_tag :source, "Audience", class: "form-label" %>
        <%= select_tag :source,
              grouped_options_for_select(
                [
                  [ "DAC Sports Network", [ [ "DAC Sports Network site", ReportsQuery::ON_SITE ] ] ],
                  [ "Partners", [ [ "All partner sites", ReportsQuery::ALL_PARTNERS ] ] + @partner_options ]
                ],
                @source
              ),
              class: "form-select" %>
      </div>
      <div class="col-auto">
        <span class="form-label d-block">Count by</span>
        <div class="btn-group" role="group" aria-label="Count by">
          <%= radio_button_tag :basis, ReportsQuery::ACTIVITY, activity, class: "btn-check", autocomplete: "off" %>
          <%= label_tag "basis_#{ReportsQuery::ACTIVITY}", "Viewing activity", class: "btn btn-outline-primary" %>
          <%= radio_button_tag :basis, ReportsQuery::AIRED, !activity, class: "btn-check", autocomplete: "off" %>
          <%= label_tag "basis_#{ReportsQuery::AIRED}", "Events aired", class: "btn btn-outline-primary" %>
        </div>
      </div>
      <div class="col-auto">
        <%= submit_tag "Apply", class: "btn btn-primary" %>
      </div>
      <div class="col-auto">
        <%= link_to "Last 7 Days", internal_reports_path(start_date: 7.days.ago.to_date, end_date: Date.current, source: @source, basis: @basis), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Last 30 Days", internal_reports_path(start_date: 30.days.ago.to_date, end_date: Date.current, source: @source, basis: @basis), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Last 90 Days", internal_reports_path(start_date: 90.days.ago.to_date, end_date: Date.current, source: @source, basis: @basis), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "All Time", internal_reports_path(start_date: ReportsQuery::ALL_TIME_START, end_date: Date.current, source: @source, basis: @basis), class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
    <p class="form-text mb-0 mt-3">
      <% if activity %>
        Counting viewing that happened <%= range_label %>, including replays of events that aired earlier.
      <% else %>
        Counting all viewing, whenever it happened, of events that aired <%= range_label %>.
      <% end %>
    </p>
  </div>
</div>

<%= render "audience_banner" %>

<h4 class="mb-1">Summary</h4>
<p class="text-muted small mb-3">
  Users are unique browsers on each site, so one person on a phone and a laptop counts twice, and partner sites can't be matched with each other.
  A view is one viewing session; a session ends after 10 minutes away.
</p>
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">Live Users</h5>
        <small class="text-muted d-block mb-2">Unique browsers that watched live.</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@summary[:live][:users]) %></p>
        <%= period_change(@summary[:live][:users], @previous_summary&.dig(:live, :users)) %>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">Live Views</h5>
        <small class="text-muted d-block mb-2">Viewing sessions of live events.</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@summary[:live][:views]) %></p>
        <%= period_change(@summary[:live][:views], @previous_summary&.dig(:live, :views)) %>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">VOD Users</h5>
        <small class="text-muted d-block mb-2">Unique browsers that watched a replay.</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@summary[:vod][:users]) %></p>
        <%= period_change(@summary[:vod][:users], @previous_summary&.dig(:vod, :users)) %>
        <small class="text-muted"><%= number_with_delimiter(@summary[:vod_30d][:users]) %> within 30 days of the event</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-0">VOD Views</h5>
        <small class="text-muted d-block mb-2">Viewing sessions of replays.</small>
        <p class="display-6 mb-1"><%= number_with_delimiter(@summary[:vod][:views]) %></p>
        <%= period_change(@summary[:vod][:views], @previous_summary&.dig(:vod, :views)) %>
        <small class="text-muted"><%= number_with_delimiter(@summary[:vod_30d][:views]) %> within 30 days of the event</small>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">By Device Type</h5>
      </div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <thead>
            <tr>
              <th></th>
              <th class="text-end">Live</th>
              <th class="text-end">VOD</th>
            </tr>
          </thead>
          <tbody>
            <% @device_breakdown.each do |device, stats| %>
              <tr>
                <td><%= device %></td>
                <td class="text-end"><%= number_to_percentage(stats[:live], precision: 1) %> <small class="text-muted">(<%= number_with_delimiter(stats[:live_count]) %>)</small></td>
                <td class="text-end"><%= number_to_percentage(stats[:vod], precision: 1) %> <small class="text-muted">(<%= number_with_delimiter(stats[:vod_count]) %>)</small></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">By Operating System</h5>
      </div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <thead>
            <tr>
              <th></th>
              <th class="text-end">Live</th>
              <th class="text-end">VOD</th>
            </tr>
          </thead>
          <tbody>
            <% @os_breakdown.each do |os, stats| %>
              <tr>
                <td><%= os %></td>
                <td class="text-end"><%= number_to_percentage(stats[:live], precision: 1) %> <small class="text-muted">(<%= number_with_delimiter(stats[:live_count]) %>)</small></td>
                <td class="text-end"><%= number_to_percentage(stats[:vod], precision: 1) %> <small class="text-muted">(<%= number_with_delimiter(stats[:vod_count]) %>)</small></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%
  # Under "activity" every count is already limited to the period, so the days-after-air
  # windows would only be slices of it; they belong to the "aired" view.
  columns = [ [ "Live", "table-danger", "live_unique_viewers", "live_views" ] ]
  columns +=
    if activity
      [ [ "VOD", "vod-all", "vod_all_viewers", "vod_all_views" ] ]
    else
      [
        [ "VOD - 1D", "vod-1d", "vod_1d_viewers", "vod_1d_views" ],
        [ "VOD - 7D", "vod-7d", "vod_7d_viewers", "vod_7d_views" ],
        [ "VOD - 30D", "vod-30d", "vod_30d_viewers", "vod_30d_views" ],
        [ "VOD - All", "vod-all", "vod_all_viewers", "vod_all_views" ]
      ]
    end
%>
<div class="card mb-5">
  <div class="card-header">
    <h5 class="mb-0">Breakdown per Event</h5>
  </div>
  <div class="card-body">
    <% if @event_stats.empty? %>
      <p class="text-muted mb-0"><%= activity ? "No viewing in the selected period." : "No events aired in the selected period." %></p>
    <% else %>
      <div class="table-responsive">
        <table class="table table-bordered table-hover mb-0 event-breakdown-table" style="--bs-border-color: #adb5bd;">
          <colgroup>
            <col class="event-col">
            <% columns.each do %><col class="data-col"><col class="data-col"><% end %>
          </colgroup>
          <thead>
            <tr>
              <th rowspan="2" class="align-bottom">Event</th>
              <% columns.each do |label, css, _, _| %>
                <th colspan="2" class="text-center <%= css %> group-start"><%= label %></th>
              <% end %>
            </tr>
            <tr>
              <% columns.each do |_, css, _, _| %>
                <th class="text-end <%= css %> group-start">Viewers</th>
                <th class="text-end <%= css %>">Views</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @event_stats.each do |event| %>
              <tr>
                <td>
                  <%= event["title"] %>
                  <br>
                  <small class="text-muted"><%= event["start_at"]&.in_time_zone("America/Chicago")&.strftime("%b %d %l:%M%P") %><%= " · #{event["sport"]}" if event["sport"].present? %></small>
                </td>
                <% columns.each do |_, css, viewers, views| %>
                  <td class="text-end <%= css %> group-start"><%= event[viewers] || 0 %></td>
                  <td class="text-end <%= css %>"><%= event[views] || 0 %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="fw-semibold">
              <td>Total of <%= pluralize(@event_stats.size, "event") %></td>
              <% columns.each do |_, css, viewers, views| %>
                <td class="text-end <%= css %> group-start"><%= number_with_delimiter(@event_stats.sum { |e| e[viewers].to_i }) %></td>
                <td class="text-end <%= css %>"><%= number_with_delimiter(@event_stats.sum { |e| e[views].to_i }) %></td>
              <% end %>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="text-muted small mt-2 mb-0">
        Totals add each event's figures together. Someone who watched two events counts in both rows, so the viewer totals here run higher than the Summary.
      </p>
    <% end %>
  </div>
</div>
