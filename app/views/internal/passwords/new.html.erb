<% content_for :title, "Reset password" %>

<h1 class="h4 mb-2">Reset your password</h1>
<p class="text-body-secondary small">We'll email you a link to choose a new one.</p>

<%= form_with url: internal_passwords_path do |f| %>
  <div class="mb-3">
    <%= f.label :email_address, "Email", class: "form-label" %>
    <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "form-control" %>
  </div>
  <%= f.submit "Email reset link", class: "btn btn-primary w-100" %>
<% end %>

<p class="text-center small mt-3 mb-0"><%= link_to "Back to sign in", internal_login_path %></p>
