<script>
  // Set the colour theme before the page paints, so dark mode doesn't flash white.
  // The theme controller keeps it up to date after that.
  (() => {
    const choice = "<%= j theme %>"
    const dark = choice === "dark" || (choice === "auto" && matchMedia("(prefers-color-scheme: dark)").matches)
    document.documentElement.dataset.bsTheme = dark ? "dark" : "light"
  })()
</script>
