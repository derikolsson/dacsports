<%= form_with(model: [:internal, @channel]) do |f| %>
  <% if @channel.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@channel.errors.count, "error") %> prohibited this channel from being saved:</h4>
      <ul>
        <% @channel.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :mux_live_stream_id, "Mux Live Stream ID", class: 'form-label' %>
    <%= f.text_field :mux_live_stream_id, class: 'form-control', required: true %>
    <small class="form-text text-muted">
      From the Mux dashboard. Saving pulls the stream's title and public playback ID, and mints a signed
      playback ID if it has none. Rename the channel by renaming the stream in Mux, then saving here.
    </small>
  </div>

  <% if @channel.persisted? %>
    <dl class="row small mb-3">
      <dt class="col-sm-3">Public playback ID</dt>
      <dd class="col-sm-9"><code><%= @channel.mux_live_playback_id.presence || "—" %></code></dd>
      <dt class="col-sm-3">Signed playback ID</dt>
      <dd class="col-sm-9"><code><%= @channel.mux_live_signed_playback_id.presence || "—" %></code></dd>
    </dl>
  <% end %>

  <fieldset class="border rounded p-3 mb-3">
    <legend class="float-none w-auto px-2 fs-6">Captions</legend>

    <div class="form-check form-switch mb-2">
      <%= f.check_box :captions_enabled, class: "form-check-input" %>
      <%= f.label :captions_enabled, "Auto-generate English captions", class: "form-check-label" %>
    </div>
    <% if @channel.persisted? %>
      <p class="small mb-3">
        <%= render "internal/vocabularies/sync_status", synced_at: @channel.captions_synced_at, error: @channel.captions_sync_error %>
      </p>
    <% end %>

    <%= f.fields_for :vocabulary do |vf| %>
      <div class="mb-0">
        <%= vf.label :phrases, "Extra vocabulary for this channel", class: "form-label" %>
        <%= vf.text_area :phrases, rows: 5, class: "form-control font-monospace" %>
        <small class="form-text text-muted">
          One phrase per line, added on top of the <%= link_to "shared vocabulary", internal_vocabulary_path %>.
          Captions only change while the stream is idle, and vocabulary changes apply the next time it goes live.
        </small>
      </div>
    <% end %>
  </fieldset>

  <div class="mb-3">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to 'Cancel', internal_channels_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
