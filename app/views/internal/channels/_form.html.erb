<%= form_with(model: [:internal, @channel]) do |f| %>
  <% if @channel.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@channel.errors.count, "error") %> prohibited this channel from being saved:</h4>
      <ul>
        <% @channel.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: 'form-label' %>
    <%= f.text_field :name, class: 'form-control', required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :mux_live_stream_id, "Mux Live Stream ID", class: 'form-label' %>
    <%= f.text_field :mux_live_stream_id, class: 'form-control' %>
    <small class="form-text text-muted">
      From the Mux dashboard. Saving pulls the public playback ID from the stream and mints a signed one if it has none.
    </small>
  </div>

  <% if @channel.persisted? %>
    <dl class="row small mb-3">
      <dt class="col-sm-3">Public playback ID</dt>
      <dd class="col-sm-9"><code><%= @channel.mux_live_playback_id.presence || "—" %></code></dd>
      <dt class="col-sm-3">Signed playback ID</dt>
      <dd class="col-sm-9"><code><%= @channel.mux_live_signed_playback_id.presence || "—" %></code></dd>
    </dl>
  <% end %>

  <div class="mb-3">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to 'Cancel', internal_channels_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
